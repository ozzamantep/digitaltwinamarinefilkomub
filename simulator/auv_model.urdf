<?xml version="1.0" ?>
<!-- ================================================================= -->
<!-- Custom 6-Thruster Subsea AUV URDF Model for Gazebo & ROS 2       -->
<!-- ================================================================= -->
<robot name="custom_auv_bluerov2">

  <!-- Base footprint -->
  <link name="base_footprint"/>

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 1. Central Pressure Hull Body Link -->
  <link name="base_link">
    <inertial>
      <mass value="22.5"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.12" ixy="0.0" ixz="0.0" iyy="0.22" iyz="0.0" izz="0.24"/>
    </inertial>

    <!-- Main White Cylindrical Core -->
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.28"/>
      </geometry>
      <material name="white">
        <color rgba="0.95 0.95 0.98 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.075" length="0.28"/>
      </geometry>
    </collision>

    <!-- Top Acrylic Electronics Box -->
    <visual>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry>
        <box size="0.22 0.19 0.062"/>
      </geometry>
      <material name="clear_acrylic">
        <color rgba="0.8 0.9 1.0 0.55"/>
      </material>
    </visual>
  </link>

  <!-- 2. Dual Stacked Carbon Fiber Battery Cylinders (Port & Starboard) -->
  <!-- Port Side Carbon Tubes (Left: +Y) -->
  <link name="port_battery_tubes">
    <visual>
      <origin xyz="0 0.118 0.026" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.30"/>
      </geometry>
      <material name="carbon_black">
        <color rgba="0.1 0.1 0.12 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 0.118 -0.026" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.30"/>
      </geometry>
      <material name="carbon_black">
        <color rgba="0.1 0.1 0.12 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0.118 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.30 0.052 0.08"/>
      </geometry>
    </collision>
  </link>
  <joint name="port_tubes_joint" type="fixed">
    <parent link="base_link"/>
    <child link="port_battery_tubes"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Starboard Side Carbon Tubes (Right: -Y) -->
  <link name="stbd_battery_tubes">
    <visual>
      <origin xyz="0 -0.118 0.026" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.30"/>
      </geometry>
      <material name="carbon_black">
        <color rgba="0.1 0.1 0.12 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="0 -0.118 -0.026" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.30"/>
      </geometry>
      <material name="carbon_black">
        <color rgba="0.1 0.1 0.12 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 -0.118 0" rpy="0 1.5708 0"/>
      <geometry>
        <box size="0.30 0.052 0.08"/>
      </geometry>
    </collision>
  </link>
  <joint name="stbd_tubes_joint" type="fixed">
    <parent link="base_link"/>
    <child link="stbd_battery_tubes"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 3. Front & Rear Aerodynamic Yellow Cowlings -->
  <!-- Front Yellow Cowling (+X = 0.18) -->
  <link name="front_cowl">
    <!-- Top Yellow Visor -->
    <visual>
      <origin xyz="0.035 0 0.054" rpy="0 0 0"/>
      <geometry>
        <box size="0.095 0.124 0.008"/>
      </geometry>
      <material name="marine_yellow">
        <color rgba="0.95 0.82 0.05 1.0"/>
      </material>
    </visual>
    <!-- Bottom Yellow Lip -->
    <visual>
      <origin xyz="0.035 0 -0.054" rpy="0 0 0"/>
      <geometry>
        <box size="0.095 0.124 0.008"/>
      </geometry>
      <material name="marine_yellow">
        <color rgba="0.95 0.82 0.05 1.0"/>
      </material>
    </visual>
    <!-- Black Vertical Duct Tube -->
    <visual>
      <origin xyz="0.005 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.108"/>
      </geometry>
      <material name="duct_black">
        <color rgba="0.08 0.08 0.1 1.0"/>
      </material>
    </visual>
    <!-- Front Camera Acrylic Dome -->
    <visual>
      <origin xyz="0.085 0 0.01" rpy="0 1.5708 0"/>
      <geometry>
        <sphere radius="0.018"/>
      </geometry>
      <material name="dome_lens">
        <color rgba="0.7 0.9 1.0 0.7"/>
      </material>
    </visual>
  </link>
  <joint name="front_cowl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="front_cowl"/>
    <origin xyz="0.18 0 0" rpy="0 0 0"/>
  </joint>

  <!-- Rear Yellow Cowling (-X = -0.18) -->
  <link name="rear_cowl">
    <visual>
      <origin xyz="-0.035 0 0.054" rpy="0 0 0"/>
      <geometry>
        <box size="0.095 0.124 0.008"/>
      </geometry>
      <material name="marine_yellow">
        <color rgba="0.95 0.82 0.05 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="-0.035 0 -0.054" rpy="0 0 0"/>
      <geometry>
        <box size="0.095 0.124 0.008"/>
      </geometry>
      <material name="marine_yellow">
        <color rgba="0.95 0.82 0.05 1.0"/>
      </material>
    </visual>
    <visual>
      <origin xyz="-0.005 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.038" length="0.108"/>
      </geometry>
      <material name="duct_black">
        <color rgba="0.08 0.08 0.1 1.0"/>
      </material>
    </visual>
  </link>
  <joint name="rear_cowl_joint" type="fixed">
    <parent link="base_link"/>
    <child link="rear_cowl"/>
    <origin xyz="-0.18 0 0" rpy="0 0 0"/>
  </joint>

  <!-- 4. 4x Horizontal 45° Vectored Thrusters at Corners -->
  <!-- T1: Front-Left (+X, +Y, 45°) -->
  <link name="thruster_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 0.7854"/>
      <geometry>
        <cylinder radius="0.038" length="0.032"/>
      </geometry>
      <material name="duct_black"/>
    </visual>
  </link>
  <joint name="thruster_1_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thruster_1"/>
    <origin xyz="0.14 0.11 0" rpy="0 0 0"/>
  </joint>

  <!-- T2: Front-Right (+X, -Y, -45°) -->
  <link name="thruster_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 -0.7854"/>
      <geometry>
        <cylinder radius="0.038" length="0.032"/>
      </geometry>
      <material name="duct_black"/>
    </visual>
  </link>
  <joint name="thruster_2_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thruster_2"/>
    <origin xyz="0.14 -0.11 0" rpy="0 0 0"/>
  </joint>

  <!-- T3: Rear-Left (-X, +Y, 135°) -->
  <link name="thruster_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 2.3562"/>
      <geometry>
        <cylinder radius="0.038" length="0.032"/>
      </geometry>
      <material name="duct_black"/>
    </visual>
  </link>
  <joint name="thruster_3_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thruster_3"/>
    <origin xyz="-0.14 0.11 0" rpy="0 0 0"/>
  </joint>

  <!-- T4: Rear-Right (-X, -Y, -135°) -->
  <link name="thruster_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 1.5708 -2.3562"/>
      <geometry>
        <cylinder radius="0.038" length="0.032"/>
      </geometry>
      <material name="duct_black"/>
    </visual>
  </link>
  <joint name="thruster_4_joint" type="fixed">
    <parent link="base_link"/>
    <child link="thruster_4"/>
    <origin xyz="-0.14 -0.11 0" rpy="0 0 0"/>
  </joint>

  <!-- Gazebo Material Colors and Physics Properties -->
  <gazebo reference="base_link">
    <material>Gazebo/White</material>
  </gazebo>
  <gazebo reference="front_cowl">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="rear_cowl">
    <material>Gazebo/Yellow</material>
  </gazebo>
  <gazebo reference="port_battery_tubes">
    <material>Gazebo/FlatBlack</material>
  </gazebo>
  <gazebo reference="stbd_battery_tubes">
    <material>Gazebo/FlatBlack</material>
  </gazebo>

</robot>
